{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Yungle",
  "colors": {
    "primary": "#2E8B57",
    "light": "#3EA76A",
    "dark": "#2E8B57"
  },
  "background": {
    "color": {
      "light": "#F4F7F2",
      "dark": "#121B25"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/yungle.png",
    "dark": "/logo/yungle.png",
    "href": "https://yungle.co"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart", "authentication"]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/send-large-files-from-the-command-line",
              "guides/file-transfer-for-ai-agents",
              "guides/wetransfer-alternative-with-an-api"
            ]
          },
          {
            "group": "Recipes",
            "pages": [
              "recipes/ci-artefacts",
              "recipes/nightly-report",
              "recipes/python",
              "recipes/client-collection",
              "recipes/agent-hand-off",
              "recipes/slack-on-download"
            ]
          },
          {
            "group": "Working with the API",
            "pages": [
              "uploads",
              "downloads",
              "transfers",
              "collections",
              "contacts",
              "webhooks",
              "errors",
              "limits",
              "unsupported"
            ]
          },
          {
            "group": "Tools",
            "pages": ["cli", "mcp"]
          },
          {
            "group": "Updates",
            "pages": ["changelog"]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/index"]
          }
        ],
        "openapi": "https://yungle.co/api/v1/openapi.json"
      }
    ]
  },
  "navbar": {
    "links": [
      { "label": "Pricing", "href": "https://yungle.co/pricing" },
      { "type": "github", "href": "https://github.com/heindewilde/yungle-clients" }
    ],
    "primary": {
      "type": "button",
      "label": "Get an API key",
      "href": "https://yungle.co/dashboard/settings/api"
    }
  },
  "contextual": {
    "options": ["copy", "view", "claude", "chatgpt", "mcp", "cursor", "vscode", "download-spec"]
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.yungle.co"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/heindewilde/yungle-clients",
      "website": "https://yungle.co"
    },
    "links": [
      {
        "header": "Yungle",
        "items": [
          { "label": "Home", "href": "https://yungle.co" },
          { "label": "Pricing", "href": "https://yungle.co/pricing" },
          { "label": "Security", "href": "https://yungle.co/security" },
          { "label": "Contact", "href": "https://yungle.co/contact" }
        ]
      }
    ]
  }
}
